# ==========================================
# Recall Monorepo Environment Configuration Guide
# ==========================================

# 1. SERVER CONFIGURATION (Create `server/.env`)
# ---------------------------------------------
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
# GEMINI_API_KEY=AIzaSy... (Get free key from https://aistudio.google.com/app/apikey)
# JWT_SECRET=your_super_secret_jwt_key_here_for_development

# 2. CLIENT CONFIGURATION (Create `client/.env`)
# ---------------------------------------------
# VITE_API_URL=http://localhost:5000/api

