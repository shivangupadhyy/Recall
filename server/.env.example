# ==========================================
# Recall Server Environment Configuration Example
# ==========================================

# Server execution port
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed frontend client URL for CORS credentials handling
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (Neon Tech PostgreSQL with pgvector)
# Example: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_jC07mSuKEiLO@ep-nameless-lake-aynggih9-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis Connection URL (Used by BullMQ queues for background PDF embeddings, quizzes, and flashcards)
# For local Redis: redis://127.0.0.1:6379
# For Upstash cloud Redis: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Google Gemini API Key for text embeddings and RAG generation
# Get your free key at: https://aistudio.google.com/app/apikey (starts with AIzaSy...)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# JWT secret key for signing authentication tokens
# Recommended: Generate a 64-character random string (e.g. node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here_for_development

# Optional: AWS S3 or Cloudflare R2 object storage credentials (if omitted, files are saved locally to server/uploads)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_bucket_name
# S3_COMPAT_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL_PREFIX=https://pub-<id>.r2.dev

